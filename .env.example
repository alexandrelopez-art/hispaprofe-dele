# DATABASE_URL: la conexión con pool (pgbouncer). La usa el cliente de Prisma en tiempo de ejecución.
# DIRECT_URL: la conexión directa, sin pool. La usa el CLI de migraciones (prisma.config.ts).
DATABASE_URL="postgresql://usuario:clave@host-pool:6543/base?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://usuario:clave@host-directo:5432/base?sslmode=require"

# El correo que manda los enlaces de entrada.
CORREO_USUARIO="ips@ips-hyl.com"
CORREO_CONTRASENA="contraseña de aplicación, distinta de la de la clínica"
CORREO_REMITENTE="contacto@hispaprofe.com"

# La dirección del sitio, para componer el enlace de entrada. OBLIGATORIA en
# producción: sin ella no se compone ningún enlace, porque la cabecera `host`
# de la petición la pone quien llama y no es de fiar.
SITIO_URL="https://hispaprofe.com"

# El almacén privado de ficheros (Vercel Blob), para las páginas escaneadas y
# los audios del examen. En Vercel llega solo, al conectar el almacén al
# proyecto. En local se baja con `vercel env pull`.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."

# Las grabaciones de los estudiantes (audio y vídeo) no van al almacén de
# arriba: son de menores y no pueden quedar accesibles a nadie por descuido,
# así que suben directo desde el navegador a una unidad compartida de Drive
# que solo escribe la cuenta robot de abajo. El estudiante nunca ve esta
# carpeta ni tiene permiso en ella.
#
# GOOGLE_CUENTA_DE_SERVICIO: el JSON entero de la cuenta robot (la clave que
# se descarga al crearla en Google Cloud), en una sola línea.
GOOGLE_CUENTA_DE_SERVICIO='{"client_email":"...","private_key":"..."}'
# DRIVE_CARPETA_GRABACIONES: el id de la unidad compartida (o de la carpeta
# dentro de ella) donde escribe la cuenta robot. Sin `supportsAllDrives`
# en la petición, escribir en una unidad compartida falla con un error que no
# explica nada; ya pasó en otro proyecto de la casa.
DRIVE_CARPETA_GRABACIONES="id-de-la-unidad-compartida"
